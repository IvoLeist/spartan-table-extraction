# SPARTAN configuration.
# Copy this file to `.env` and fill in YOUR OWN values. `.env` is git-ignored;
# never commit real keys. Every variable can also be set in the environment.

# --- OCR (only used for scanned pages / --text-source ocr) -------------------
# Offline (default): install Tesseract, then point to it if it is not on PATH.
# SPARTAN_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Cloud (optional, --ocr-engine azure): add your own Azure AI Vision resource.
# SPARTAN_AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# SPARTAN_AZURE_VISION_KEY=<your-azure-vision-key>

# --- LLM for the optional PCN mapping (--pcn) --------------------------------
# ollama (local, default) | azure | none
SPARTAN_LLM_PROVIDER=ollama
SPARTAN_OLLAMA_HOST=http://localhost:11434
SPARTAN_OLLAMA_MODEL=gemma4:latest
SPARTAN_LLM_TIMEOUT=180

# Cloud (optional, SPARTAN_LLM_PROVIDER=azure): add your own Azure OpenAI deployment.
# SPARTAN_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# SPARTAN_AZURE_OPENAI_KEY=<your-azure-openai-key>
# SPARTAN_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- API ---------------------------------------------------------------------
SPARTAN_CORS_ORIGINS=["*"]
SPARTAN_MAX_UPLOAD_MB=50

# --- Tests -------------------------------------------------------------------
# Folder with PDF notices for the end-to-end tests (default: ../Dataset).
# SPARTAN_DATASET_DIR=
